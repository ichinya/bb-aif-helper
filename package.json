    "*.tsx",
    "*.css",
    "skills",
    "tests",
    "docs",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "VERIFICATION.md",
    "tsconfig.json"
  ],
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "AI Factory Chat [Experimental]",
